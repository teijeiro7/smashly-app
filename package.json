{
  "name": "smashly-app",
  "version": "1.0.0",
  "description": "Smashly - Padel Rackets Management System",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "install:all": "npm install && cd api && npm install && cd ../frontend && npm install",
    "typecheck:api": "cd api && npx tsc --noEmit",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix",
    "format": "cd frontend && npm run format",
    "format:check": "cd frontend && npm run format:check",
    "quality:check": "npm run typecheck:api && npm run lint",
    "quality:fix": "npm run lint:fix && npm run format",
    "test:all": "cd frontend && npm run test:unit",
    "build:all": "npm run typecheck:api && cd frontend && npm run build",
    "record:demo": "node testing/scripts/record-demo.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.10",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "undici": "^7.16.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@tanstack/react-query": "^5.90.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "playwright": "^1.57.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeurjc-students/2025-Smashlyapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/codeurjc-students/2025-Smashlyapp/issues"
  },
  "homepage": "https://github.com/codeurjc-students/2025-Smashlyapp#readme"
}
